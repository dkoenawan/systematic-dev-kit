#!/usr/bin/env bash
# post-commit hook — installed by `task install`
# Warns when skill/hook files changed but plugin.json version was not bumped.

PLUGIN_JSON=".claude-plugin/plugin.json"
CURRENT_VERSION=$(grep '"version"' "$PLUGIN_JSON" | sed 's/.*"version": *"\([^"]*\)".*/\1/')
PREV_VERSION=$(git show HEAD~1:"$PLUGIN_JSON" 2>/dev/null | grep '"version"' | sed 's/.*"version": *"\([^"]*\)".*/\1/')

# Check if any skill/hook content changed in this commit
CONTENT_CHANGED=$(git diff HEAD~1 HEAD --name-only 2>/dev/null | grep -E '^(skills|hooks)/' || true)

if [[ -n "$CONTENT_CHANGED" && "$CURRENT_VERSION" == "$PREV_VERSION" ]]; then
  echo ""
  echo "┌─────────────────────────────────────────────────────┐"
  echo "│  compass-labs: version not bumped             │"
  echo "│                                                     │"
  echo "│  Skill/hook files changed but plugin.json is still  │"
  echo "│  at v$CURRENT_VERSION. Claude will keep running the cached   │"
  echo "│  version until you release.                         │"
  echo "│                                                     │"
  echo "│  Run:  task release BUMP=patch                      │"
  echo "└─────────────────────────────────────────────────────┘"
  echo ""
fi
